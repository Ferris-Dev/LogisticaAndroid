<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TrackingLogistic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- SplashScreen API: fondo azul marino de la marca + ícono del paquete -->
    <style name="Theme.TrackingLogistic.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TrackingLogistic</item>
    </style>
</resources>
